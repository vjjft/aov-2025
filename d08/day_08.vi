
// use #util::io::{log as _, out as _};
use #util::io;
// use #util::io;
use #root::data::{Array, Map};

pub fn main(&io: &IO) {
  let box_ = [];
  while io.read_line() is Some(line) {
    let val_ = line.split(",");
    let x = N64::parse(val_.get(0).assume()).assume();
    let y = N64::parse(val_.get(1).assume()).assume();
    let z = N64::parse(val_.get(2).assume()).assume();
    let box = (x, y, z);
    box_ ++= [box];
  }
  let box_arr = box_ as Array;
  let box_count = box_.len();
  let pair_ = [];
  let i = 0;
  while box_.pop_front() is Some(box) {
    let (x, y, z) = box;
    let a = i;
    let b = i;
    i += 1;
    for alt in box_ {
      b += 1
      let (p, q, r) = alt;
      let dist = x.diff(p) ** 2 + y.diff(q) ** 2 + z.diff(r) ** 2;
      pair_ ++= [BoxPair({ a, b, dist })];
    }
  }
  pair_.sort();

  let part1: N32 = 0;
  let part2: N64 = 0[N64];

  let checkpoint = if box_count == 20 {
    10
  } else {
    1000
  };

  let d = DisjointSet::empty[N32];
  let n = 0;
  for BoxPair({ a, b, dist: _ }) in pair_ {
    n += 1;
    let s = d.union_sets(&a, &b);
    if (n == checkpoint) {
      let c_ = d!.size_.values().collect[List, _, _]();
      c_.sort();
      c_.reverse();
      assert (c_.pop_front(), c_.pop_front(), c_.pop_front()) is (Some(&a), Some(&b), Some(&c)) else {}

      let product = a * b * c;

      part1 = product;
    }
    if (s == box_count) {
      let box_a = box_arr.get(a).assume();
      let box_b = box_arr.get(b).assume();

      part2 = box_a.0 * box_b.0
      break;
    }
  }

  io.println("Part 1: {part1}");
  io.println("Part 2: {part2}");
}

fn .diff(a: N64, b: N64) -> N64 {
  if (a < b) {
    b - a
  } else {
    a - b
  }
}

struct* DisjointSet[N]({ parent_: Map[N, N], size_: Map[N, N32] });
mod DisjointSet[N*; Ord[N]] {
  use #root::ops::comparison::Ord;
  pub const empty[N]: DisjointSet[N] = DisjointSet({
    parent_: Map::empty[N, N],
    size_: Map::empty[N, N32],
  });
  fn .make_set[...](&self: &DisjointSet[N], n: N) {
    self!.parent_.insert(n, n);
    self!.size_.insert(n, 1);
  }
  pub fn .find_set[...](&self: &DisjointSet[N], &n: &N) -> N {
    assert self!.parent_.get(&n) is Some(p) else {
      self.make_set(n);
      n
    }
    if n.cmp(&p) is Ord::Eq() {
      return n;
    }
    self.find_set(&p)
  }
  pub fn .union_sets[... ; Show[N]](&self: &DisjointSet[N], &a: &N, &b: &N) -> N32 {
    let x = self.find_set(&a);
    let y = self.find_set(&b);
    let sx = self!.size_.get(&x).assume();
    if x.cmp(&y) is Ord::Eq() {
      return sx;
    }
    let sy = self!.size_.get(&y).assume();
    let s = sy + sx;
    { a, b, sx, sy, x, y }.dbg()
    self!.parent_.insert(x, y);
    self!.size_.insert(y, s);
    self!.size_.remove(&x);
    s
  }
  pub impl show[... ; Show[N]]: Show[DisjointSet[N]];
}

struct* BoxPair({ a: N32, b: N32, dist: N64 });
mod BoxPair {
  use #root::ops::comparison::Ord;
  pub impl ord: Ord[BoxPair] {
    fn cmp(&a: &BoxPair, &b: &BoxPair) -> Ord {
      Ord::cmp[N64](&a.dist, &b.dist)
    }
    fn lt(&a: &BoxPair, &b: &BoxPair) -> Bool {
      Ord::lt_from_cmp(&a, &b)
    }
    fn le(&a: &BoxPair, &b: &BoxPair) -> Bool {
      Ord::le_from_cmp(&a, &b)
    }
  }
  pub impl show: Show[BoxPair];
}
